# SUPABASE_URL: Your Supabase project URL (e.g. https://xyzcompany.supabase.co)
# Configure this in the Secrets panel in AI Studio.
SUPABASE_URL=YOUR_SUPABASE_URL

# SUPABASE_ANON_KEY: Your Supabase project anon/public key.
# Configure this in the Secrets panel in AI Studio.
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY


# MAPBOX_ACCESS_TOKEN: Public token (pk.*) from account.mapbox.com for rendering Mapbox maps at runtime.
# Configure this in the Secrets panel in AI Studio.
MAPBOX_ACCESS_TOKEN=YOUR_MAPBOX_ACCESS_TOKEN

# MAPBOX_DOWNLOADS_TOKEN: Secret token (sk.*) with DOWNLOADS:READ scope from account.mapbox.com for Gradle SDK download.
# Configure this in the Secrets panel in AI Studio.
MAPBOX_DOWNLOADS_TOKEN=YOUR_MAPBOX_DOWNLOADS_TOKEN

